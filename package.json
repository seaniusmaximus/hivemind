{
  "name": "hivemind",
  "private": true,
  "version": "0.0.1",
  "description": "A retro-arcade word game where you command a hive of bees to assemble words on a hex grid.",
  "workspaces": [
    "shared",
    "client",
    "server"
  ],
  "scripts": {
    "dev": "npm-run-all --parallel dev:shared dev:server dev:client",
    "dev:shared": "npm run watch -w shared",
    "dev:client": "npm run dev -w client",
    "dev:server": "npm run dev -w server",
    "build": "npm-run-all build:shared build:client build:server",
    "build:shared": "npm run build -w shared",
    "build:client": "npm run build -w client",
    "build:server": "npm run build -w server",
    "deploy": "npm run build:shared && npm run build:client && npm run deploy -w server",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "tsc -b --pretty"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^25.6.0",
    "jest": "^30.3.0",
    "jest-environment-jsdom": "^30.3.0",
    "npm-run-all": "^4.1.5",
    "ts-jest": "^29.4.9",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=20"
  }
}
